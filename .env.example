# Copie este arquivo para .env e ajuste os valores.
# NUNCA versione o arquivo .env real.

# Chave usada para assinar os tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Tempo de validade do token, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de dados (SQLite por padrão; troque para PostgreSQL se quiser)
DATABASE_URL=sqlite:///./treino.db

# Origens autorizadas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
